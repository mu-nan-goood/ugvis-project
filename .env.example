# ========================
# 数据库配置
# ========================
# 本地开发（SQLite，单文件零配置）：
# DATABASE_URL=sqlite:///./ugvis.db
#
# Docker 生产环境（PostgreSQL，由 docker-compose.yml 自动注入）：
# DATABASE_URL=postgresql+psycopg2://ugvis:ugvis123@db:5432/ugvis_db

# ========================
# CORS 跨域白名单
# ========================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ========================
# AI / LLM 配置（后端 Planning 路由使用）
# ========================
# 各提供商 API Key（至少配置一个）
DEEPSEEK_API_KEY=your-deepseek-key
# OPENAI_API_KEY=your-openai-key
# KIMI_API_KEY=your-kimi-key
# CLAUDE_API_KEY=your-claude-key

# 默认提供商: deepseek | openai | kimi | claude | custom
LLM_DEFAULT_PROVIDER=deepseek
LLM_DEFAULT_MODEL=deepseek-chat
LLM_TIMEOUT=120

# Custom LLM (如用户自建服务)
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_BASE_URL=

# OpenClaw Gateway 配置（可选回退）
OPENCLAW_URL=http://localhost:28789
OPENCLAW_TOKEN=your-openclaw-token


