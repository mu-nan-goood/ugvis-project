# UGVIS Backend Environment Variables
# Copy this file to .env and fill in your values

# === LLM API Keys (at least one required) ===
# DeepSeek (推荐)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# OpenAI (可选)
OPENAI_API_KEY=your-openai-api-key-here

# Kimi / Moonshot (可选)
KIMI_API_KEY=your-kimi-api-key-here

# Claude / Anthropic (可选)
CLAUDE_API_KEY=your-claude-api-key-here

# === LLM Default Settings ===
LLM_DEFAULT_PROVIDER=deepseek
LLM_DEFAULT_MODEL=deepseek-chat
LLM_TIMEOUT=120

# === Embedding Service (RAG) ===
# Option 1: LM Studio (本地，需安装 LM Studio + nomic-embed-text 模型)
EMBEDDING_API_BASE=http://localhost:1234/v1
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v2-moe

# Option 2: Ollama (本地，推荐用于分发)
#   1. 安装: winget install Ollama
#   2. 拉取模型: ollama pull nomic-embed-text
#   3. 修改 .env:
# EMBEDDING_API_BASE=http://localhost:11434/v1
# EMBEDDING_MODEL=nomic-embed-text

# === Database ===
# SQLite (默认)
DATABASE_URL=sqlite:///./ugvis.db

# PostgreSQL (可选，生产环境推荐)
# DATABASE_URL=postgresql://user:password@localhost:5432/ugvis

# === Security ===
# JWT Secret for authentication (generate a random string)
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
