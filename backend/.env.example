# UGVIS Backend Environment Variables
# Copy this file to .env and fill in your values

# === LLM API Keys (at least one required) ===
# DeepSeek (recommended)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# OpenAI (optional)
OPENAI_API_KEY=your-openai-api-key-here

# Kimi / Moonshot (optional)
KIMI_API_KEY=your-kimi-api-key-here

# Claude / Anthropic (optional)
CLAUDE_API_KEY=your-claude-api-key-here

# === LLM Default Settings ===
LLM_DEFAULT_PROVIDER=deepseek
LLM_DEFAULT_MODEL=deepseek-chat
LLM_TIMEOUT=120

# === Custom LLM (optional, user provides their own endpoint) ===
# CUSTOM_LLM_API_KEY=your-custom-api-key
# CUSTOM_LLM_BASE_URL=https://your-llm-endpoint/v1

# === Embedding Service (RAG) ===
# Option 1: LM Studio (local, requires LM Studio + nomic-embed-text model)
EMBEDDING_API_BASE=http://localhost:1234/v1
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v2-moe

# Option 2: Ollama (local, recommended for distribution)
#   1. Install: winget install Ollama
#   2. Pull model: ollama pull nomic-embed-text
#   3. Update .env:
# EMBEDDING_API_BASE=http://localhost:11434/v1
# EMBEDDING_MODEL=nomic-embed-text

# === Database ===
# SQLite (default)
DATABASE_URL=sqlite:///./ugvis.db

# PostgreSQL (optional, recommended for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/ugvis

# === JWT Authentication ===
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === Initial Admin User (created on first startup) ===
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=ChangeMe123!Strong