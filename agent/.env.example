# UGVIS AI Agent 环境变量配置

# LLM API 配置（MiniMax 平台申请）
LLM_API_KEY=your-minimax-api-key-here
LLM_BASE_URL=https://api.minimax.chat/v1
LLM_MODEL=MiniMax-Text-01
# MiniMax GroupId（从 MiniMax 平台 - 控制台 - API Key 页面获取，用于计费）
LLM_API_GROUP_ID=your-group-id-here

# UGVIS 后端配置
UGVIS_API_URL=http://localhost:8000

# Agent 服务配置
AGENT_PORT=8001
MAX_TOKENS=4096
TEMPERATURE=0.3

# CORS 允许的前端域名（多个用逗号分隔，生产环境必须设置）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
