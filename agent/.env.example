# UGVIS AI Agent 环境变量配置

# LLM API 配置（申请 MiMo 后填写）
LLM_API_KEY=your-mimo-api-key-here
LLM_BASE_URL=https://api.mimo.ai/v1
LLM_MODEL=mimo-pro

# UGVIS 后端配置
UGVIS_API_URL=http://localhost:8000

# Agent 服务配置
AGENT_PORT=8001
MAX_TOKENS=4096
TEMPERATURE=0.3

# CORS 允许的前端域名（多个用逗号分隔，生产环境必须设置）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
