# UGVIS Frontend Environment Variables
# Copy this file to .env and fill in your values

# === Street View API Keys ===
# Gaode (AMap) JS API Key — apply at https://console.amap.com/dev/key/app (select Web JS API)
VITE_AMAP_KEY=your-amap-key-here

# Baidu Map JS API Key — apply at https://lbsyun.baidu.com/apiconsole/key (select browser type)
VITE_BAIDU_AK=your-baidu-ak-here

# Note: Without these keys, street view will fall back to opening in a new browser tab.